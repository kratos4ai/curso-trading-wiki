    "test": "node --test",
    "check": "npm run docs:build && npm test"
  },
  "devDependencies": {
    "mermaid": "11.17.2",
    "vitepress": "1.6.4",
    "vitepress-plugin-mermaid": "2.0.17"
  }
}
