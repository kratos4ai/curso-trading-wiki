{
  "name": "curso-trading-wiki",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Wiki educacional de trading com desenvolvimento guiado por especificação e Pareto.",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "docs:dev": "vitepress dev docs --host 127.0.0.1",
